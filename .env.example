# For local development with Ollama, no .env file is needed by default.
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_URL=http://127.0.0.1:11434
PORT=3000

# For Vercel deployment, configure these as Project Environment Variables.
# Never add a real token to frontend JavaScript or commit it to Git.
HF_TOKEN=hf_replace_with_your_inference_token
HF_MODEL=openai/gpt-oss-20b
